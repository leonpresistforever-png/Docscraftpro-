{
  "entities": {
    "Document": {
      "title": "Document",
      "description": "User created document",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "ownerId": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "isStarred": { "type": "boolean" },
        "isShared": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["ownerId", "title", "content"]
    },
    "DocumentHistory": {
      "title": "DocumentHistory",
      "description": "Snapshot of previous versions of the document",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "version": { "type": "number" },
        "createdAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["title", "content"]
    },
    "NexusChat": {
      "title": "NexusChat",
      "description": "Logs for chat interactions with Nexus AI",
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "number" },
        "duration": { "type": "number" },
        "docId": { "type": "string" }
      },
      "required": ["role", "content", "timestamp"]
    },
    "PrivacyConsent": {
      "title": "PrivacyConsent",
      "description": "User consent to privacy policy",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "agreedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["userId"]
    },
    "User": {
      "title": "User",
      "description": "User profile with credits",
      "type": "object",
      "properties": {
        "credits": { "type": "number" },
        "subscription": { "type": "string" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["credits"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Conversation history session for AI Sheets or Nexus",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "appType": { "type": "string" },
        "messages": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["title", "appType", "messages", "ownerId"]
    },
    "InputHistory": {
      "title": "InputHistory",
      "description": "User input prompt history",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "prompt": { "type": "string" },
        "timestamp": { "type": "string", "format": "timestamp" }
      },
      "required": ["userId", "prompt"]
    },
    "DocAttachment": {
      "title": "DocAttachment",
      "description": "Uploaded doc attachment containing filename, type and base64 data",
      "type": "object",
      "properties": {
        "filename": { "type": "string" },
        "contentType": { "type": "string" },
        "data": { "type": "string" },
        "createdAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["filename", "contentType", "data"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "User submitted support ticket",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "email": { "type": "string" },
        "issue": { "type": "string" },
        "createdAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["username", "email", "issue"]
    }
  },
  "firestore": {
    "/support_tickets/{ticketId}": {
      "schema": { "$ref": "SupportTicket" },
      "description": "User submitted support tickets"
    },
    "/inputHistory/{historyId}": {
      "schema": { "$ref": "InputHistory" },
      "description": "Input history for a user"
    },
    "/privacy_consents/{consentId}": {
      "schema": { "$ref": "PrivacyConsent" },
      "description": "Record of user accepting the privacy policy"
    },
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles"
    },
    "/documents/{documentId}": {
      "schema": { "$ref": "Document" },
      "description": "Top-level collection holding all documents"
    },
    "/documents/{documentId}/history/{historyId}": {
      "schema": { "$ref": "DocumentHistory" },
      "description": "Sub-collection of document containing historical versions"
    },
    "/nexus_chats/{chatId}": {
      "schema": { "$ref": "NexusChat" },
      "description": "Top-level collection for nexus global conversations"
    },
    "/chat_sessions/{sessionId}": {
      "schema": { "$ref": "ChatSession" },
      "description": "Conversation history sessions"
    },
    "/doc_attachments/{attachmentId}": {
      "schema": { "$ref": "DocAttachment" },
      "description": "Media and file attachments linked in documents"
    }
  }
}
