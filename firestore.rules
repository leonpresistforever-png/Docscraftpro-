rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection: Profiles, credits, and nested configuration documents only accessible by the owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /config/{configId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Documents Collection: Access strictly restricted to owner or shared visibility
    match /documents/{documentId} {
      allow get: if request.auth != null && (resource.data.ownerId == request.auth.uid || resource.data.isShared == true);
      allow list: if request.auth != null && (resource.data.ownerId == request.auth.uid || resource.data.isShared == true);
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // Subcollection history: inherit permissions strictly from the parent document
      match /history/{historyId} {
        allow read, write: if request.auth != null && (get(/databases/$(database)/documents/documents/$(documentId)) == null || get(/databases/$(database)/documents/documents/$(documentId)).data.ownerId == request.auth.uid || get(/databases/$(database)/documents/documents/$(documentId)).data.isShared == true);
      }
    }

    // Chat Sessions Collection: History logs strictly owner-owned
    match /chat_sessions/{sessionId} {
      allow read: if request.auth != null && (resource == null || resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Input Prompt History Collection: History logs strictly owner-owned
    match /inputHistory/{historyId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Document Media/File Attachments: Secure access restricted strictly to owner only
    match /doc_attachments/{attachmentId} {
      allow read: if request.auth != null && (resource == null || resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Support Tickets Collection: Accessible for creation by anyone, but read/write/delete restricted to ensure data privacy
    match /support_tickets/{ticketId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Tasks Collection: Writing goals and tasks for each user, strictly owner-owned
    match /tasks/{taskId} {
      allow read: if request.auth != null && (resource == null || resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Privacy Consents Collection: Records of users accepting the privacy policy
    match /privacy_consents/{consentId} {
      allow create: if request.auth != null && request.auth.uid == consentId && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && request.auth.uid == consentId;
      allow update, delete: if false; // Once consented, cannot be modified or deleted directly
    }

    // Nexus Chat Logs: Disabled/unused to prevent any unintended access
    match /nexus_chats/{chatId} {
      allow read, write: if false;
    }
    // Paper Drafts (Landing Page Feature): Allows public creation so users can test out drafting without logging in
    match /paper_drafts/{draftId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
  }
}
